{
  "name": "aura-robot-data-discovery",
  "private": true,
  "version": "0.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "doctor": "node -e \"console.log(`node ${process.version}`); console.log(`npm user agent: ${process.env.npm_config_user_agent || `unknown`}`)\"",
    "judge": "VITE_AURA_JUDGE_MODE=true vite",
    "build:judge": "VITE_AURA_JUDGE_MODE=true tsc -b && VITE_AURA_JUDGE_MODE=true vite build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "@solana/web3.js": "1.98.4",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.14",
    "source-map-js": "1.2.1"
  },
  "overrides": {
    "source-map-js": "1.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.3.0"
  },
  "allowScripts": {
    "bufferutil@4.1.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "utf-8-validate@6.0.6": true
  }
}
